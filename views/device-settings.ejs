<!DOCTYPE html>
<html lang="sl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>ESP32 Dashboard</title>
<style>
  /* Ozadje izlinearnega gradienta */
  body {
    margin: 0;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #6371c7 0%, #8059c7 100%);
    min-height: 100vh;
    color: #222;
  }

  /* Zgornji navigation bar */
  header {
    height: 56px;
    background: #efeff5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 24px;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.1);
  }
  .logo {
    font-weight: 700;
    font-size: 1.3rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .logo .icon-chip {
    font-size: 1.5rem;
    user-select: none;
  }
  nav {
    display: flex;
    gap: 26px;
    font-weight: 600;
    color: #555;
  }
  nav a {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 1rem;
    color: #555;
    text-decoration: none;
    cursor: pointer;
  }
  nav a:hover {
    color: #3671f3;
  }

  main {
    max-width: 960px;
    margin: 40px auto 80px;
    padding: 0 20px;
  }

  h2 {
    font-weight: 600;
    font-size: 1.6rem;
    margin-bottom: 30px;
    color: white;
  }

  /* Postavljanje področij */
  .dashboard {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
  }

  /* Kartica naprave */
  .device-card {
    background: white;
    border-radius: 14px;
    box-shadow: 0 8px 22px rgba(0,0,0,0.15);
    width: 280px;
    overflow: hidden;
    color: #222;
    font-size: 0.95rem;
  }
  .device-header {
    background-color: #3671f3;
    color: white;
    padding: 12px 20px;
    font-weight: 600;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }
  .device-header .icon-device {
    margin-right: 8px;
    font-size: 1.3rem;
  }
  .device-status {
    display: flex;
    align-items: center;
    color: #f44336;
    font-weight: 600;
  }
  .status-dot {
    width: 14px;
    height: 14px;
    background-color: #f44336;
    border-radius: 50%;
    margin-right: 8px;
  }
  .device-content {
    padding: 20px 24px 28px;
  }
  .device-content b {
    font-weight: 700;
  }
  .device-content em {
    font-style: italic;
    color: #666;
    font-size: 0.87rem;
    margin-top: 14px;
    display: block;
  }
  .btn-settings {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background-color: #007aff;
    color: white;
    border:none;
    border-radius: 30px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    box-shadow: 0 5px 15px rgba(0,122,255,0.5);
    margin-top: 22px;
    user-select: none;
    text-decoration: none;
  }
  .btn-settings:hover {
    background-color: #005bb5;
  }
  .icon-gear {
    font-size: 1.2rem;
    user-select: none;
  }

  /* Obrazec za dodajanje nove naprave */
  .add-device-section {
    flex: 1 1 0;
    background: white;
    border-radius: 20px;
    padding: 36px 40px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    min-width: 350px;
  }
  .add-device-section h3 {
    margin-top: 0;
    margin-bottom: 36px;
    font-weight: 600;
    font-size: 1.8rem;
    color: #222;
  }
  form.add-device {
    display: flex;
    align-items: flex-end;
    gap: 28px;
    flex-wrap: wrap;
  }
  form.add-device > div {
    flex: 1 1 280px;
    min-width: 240px;
    display: flex;
    flex-direction: column;
  }
  form.add-device label {
    margin-bottom: 8px;
    font-weight: 600;
    font-size: 1rem;
  }
  
  form.add-device input[type="text"] {
    font-size: 1.1rem;
    padding: 14px 16px;
    border: 2px solid #ddd;
    border-radius: 14px;
    transition: border-color 0.25s ease;
    color: #444;
  }
  form.add-device input[type="text"]:focus {
    outline: none;
    border-color: #3671f3;
    background-color: #e9f2ff;
  }
  .small-text {
    font-size: 0.82rem;
    color: #666;
    margin-top: 6px;
  }
  form.add-device button {
    background-color: #2e7d32;
    color: white;
    font-weight: 700;
    font-size: 1.1rem;
    border: none;
    border-radius: 34px;
    padding: 14px 44px;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(46,125,50,0.4);
    user-select: none;
    white-space: nowrap;
    flex-grow: 0;
  }
  form.add-device button:hover {
    background-color: #1b4d1b;
  }

  /* Ikone */
  .icon-device::before {
    content: "\1F4BB";
    margin-right: 8px;
  }
  .icon-gear::before {
    content: "\2699";
  }

  /* Responsive */
  @media (max-width: 780px) {
    main {
      margin: 30px 20px 60px;
    }
    .dashboard {
      flex-direction: column;
      gap: 40px;
    }
    .device-card, 
    .add-device-section {
      width: 100% !important;
      min-width: unset !important;
    }
    form.add-device {
      flex-direction: column;
      gap: 20px;
    }
    form.add-device > div {
      min-width: 100%;
    }
  }
</style>
</head>
<body>

<header>
  <div class="logo"><span class="icon-chip">🖥️</span>ESP32 Dashboard</div>
  <nav>
    <a href="#">Domov</a>
    <a href="#">Admin Panel</a>
    <a href="#">Odjava</a>
  </nav>
</header>

<main>
  <h2>Moje naprave</h2>
  <div class="dashboard">
    <section class="device-card">
      <div class="device-header">
        <span><span class="icon-device"></span> krmilnica1</span>
        <span class="device-status"><span class="status-dot"></span>Offline</span>
      </div>
      <div class="device-content">
        ID: ABCDEFGH<br />
        <b>Vrednost 1:</b> 25.30<br />
        <b>Vrednost 2:</b> 62.50<br />
        <em>Zadnja posodobitev: 16. 1. 2026, 22:34:02</em>
        <a href="#" class="btn-settings"><span class="icon-gear"></span> Nastavitve</a>
      </div>
    </section>

    <section class="add-device-section">
      <h3>Dodaj novo napravo</h3>
      <form class="add-device" action="#" method="POST" novalidate>
        <div>
          <label for="device-name">Ime naprave</label>
          <input id="device-name" name="device-name" type="text" placeholder="npr. Dnevna soba" required />
        </div>
        <div>
          <label for="device-id">ID naprave (8 znakov)</label>
          <input id="device-id" name="device-id" type="text" maxlength="8" minlength="8" placeholder="npr. ABCD1234" pattern="[A-Za-z0-9]{8}" required />
          <div class="small-text">Natančno 8 alfanumeričnih znakov</div>
        </div>
        <button type="submit">+ Dodaj</button>
      </form>
    </section>
  </div>
</main>

</body>
</html>
