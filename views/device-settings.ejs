<!DOCTYPE html>
<html lang="sl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Device Settings</title>
<style>
  body { font-family: Arial, sans-serif; margin: 20px; }
  label { display: inline-block; width: 150px; margin-bottom: 8px; }
  input[type="text"], input[type="number"] { width: 80px; padding: 4px; }
  input[type="checkbox"] { margin-left: 5px; }
  .section { margin-bottom: 25px; padding-bottom: 15px; border-bottom: 1px solid #ccc; }
  button { margin-top: 10px; margin-right: 8px; padding: 6px 12px; background-color: #007BFF; color: white; border: none; border-radius: 4px; cursor: pointer; }
  button:hover { background-color: #0056b3; }
</style>
</head>
<body>

<h2>Nastavitve naprave (Device Settings)</h2>

<form action="/submit-settings" method="POST">

  <div class="section">
    <h3>Osnovne nastavitve</h3>
    <label for="ura_h">Ura:</label>
    <input id="ura_h" name="ura_h" type="number" min="0" max="23" value="15" /> h :
    <input id="ura_min" name="ura_min" type="number" min="0" max="59" value="38" /> min
    <br />

    <label for="datum_dan">Datum:</label>
    <input id="datum_dan" name="datum_dan" type="number" min="1" max="31" value="7" /> .
    <input id="datum_mesec" name="datum_mesec" type="number" min="1" max="12" value="1" /> .
    <input id="datum_leto" name="datum_leto" type="number" min="2023" max="2100" value="2025" />
    <br />

    <label for="visina">Višina:</label>
    <input id="visina" name="visina" type="number" min="0" step="0.01" value="100.00" /> cm
    <br />

    <label for="wifi_cas">Wifi čas:</label>
    <input id="wifi_cas" name="wifi_cas" type="number" min="0" value="30" /> s
    <br />

    <label for="napetost">Obvestilo napetost:</label>
    <input id="napetost" name="napetost" type="number" step="0.01" value="11.00" /> V
    <br />

    <label for="krmilo">Obvestilo krmilo:</label>
    <input id="krmilo" name="krmilo" type="number" min="0" max="100" value="20" /> %
    <br />

    <label for="obvestilo_stevilka">Obvestilo številka:</label>
    <input id="obvestilo_stevilka" name="obvestilo_stevilka" type="tel" placeholder="+38631280019" value="+38631280019" />
  </div>

  <div class="section">
    <h3>Časovnik in motor</h3>
    <label>Status časovnika:</label>
    <span>On</span>
    <br />

    <label for="ura1_h">Ura 1:</label>
    <input id="ura1_h" name="ura1_h" type="number" min="0" max="23" value="15" /> h :
    <input id="ura1_min" name="ura1_min" type="number" min="0" max="59" value="40" /> min
    <br />

    <label for="ura2_h">Ura 2:</label>
    <input id="ura2_h" name="ura2_h" type="number" min="0" max="23" value="16" /> h :
    <input id="ura2_min" name="ura2_min" type="number" min="0" max="59" value="50" /> min
    <input id="casovnik_2" name="casovnik_2" type="checkbox" checked /> časovnik 2
    <br />

    <label for="cas_delovanja">Čas delovanja:</label>
    <input id="cas_delovanja" name="cas_delovanja" type="number" min="0" value="20" /> s
    <br />

    <label for="hitrost_motorja">Hitrost motorja:</label>
    <input id="hitrost_motorja" name="hitrost_motorja" type="number" min="0" max="100" value="100" /> %
    <br />

    <label>Dnevi:</label>
    <label><input type="checkbox" name="dni[]" value="PON" checked /> PON</label>
    <label><input type="checkbox" name="dni[]" value="TOR" checked /> TOR</label>
    <label><input type="checkbox" name="dni[]" value="SRE" checked /> SRE</label>
    <label><input type="checkbox" name="dni[]" value="CET" checked /> ČET</label>
    <label><input type="checkbox" name="dni[]" value="PET" checked /> PET</label>
    <label><input type="checkbox" name="dni[]" value="SOB" checked /> SOB</label>
    <label><input type="checkbox" name="dni[]" value="NED" checked /> NED</label>
  </div>

  <button type="submit">Potrdi</button>
  <button type="button" onclick="window.history.back();">Nazaj</button>
  <button type="button">Stanje</button>
  <button type="button">Test</button>
  <button type="button">GSM</button>
  <button type="button">Nastavitve</button>

</form>

</body>
</html>
