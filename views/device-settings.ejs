<!DOCTYPE html>
<html lang="sl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Nastavitve in Krmilnica</title>
<style>
  body {
    font-family: Arial, sans-serif;
    margin: 12px;
    background-color: white;
    color: black;
  }
  h3 {
    font-weight: bold;
    margin-bottom: 12px;
  }
  label {
    display: inline-block;
    min-width: 120px;
    margin-bottom: 8px;
    vertical-align: middle;
  }
  input[type="number"], 
  input[type="tel"] {
    width: 55px;
    border: 1px solid #999;
    border-radius: 4px;
    padding: 2px 5px;
    font-size: 1em;
    vertical-align: middle;
    color: #555;
  }
  input[type="tel"] {
    width: 140px;
  }
  input[type="checkbox"] {
    vertical-align: middle;
    transform: scale(1.1);
    margin-right: 5px;
    cursor: pointer;
  }
  button {
    background-color: #007AFF;
    color: white;
    border: none;
    border-radius: 12px;
    padding: 7px 14px;
    font-size: 1em;
    margin-top: 10px;
    margin-right: 10px;
    cursor: pointer;
    box-shadow: 0 2px 5px rgba(0,122,255,0.5);
    user-select: none;
    transition: background-color 0.3s ease;
  }
  button:hover {
    background-color: #005bb5;
  }
  button:active {
    background-color: #004080;
  }
  .btn-group {
    margin-top: 12px;
  }
  .days label {
    display: block;
    font-weight: normal;
    margin-left: 20px;
    margin-bottom: 5px;
    cursor: pointer;
  }
  form {
    margin-bottom: 40px;
  }
  /* Razmak med elementi vrstice */
  .input-line {
    margin-right: 6px;
  }
</style>
</head>
<body>

<!-- Nastavitve naprave -->
<form action="/" method="GET" novalidate>
  <h3>Nastavitve</h3>
  
  <label>Ura:</label>
  <input class="input-line" type="number" name="ura_h" min="0" max="23" value="15" required /> h :
  <input class="input-line" type="number" name="ura_min" min="0" max="59" value="38" required /> min
  <br />

  <label>Datum:</label>
  <input class="input-line" type="number" name="datum_dan" min="1" max="31" value="7" required /> .
  <input class="input-line" type="number" name="datum_mesec" min="1" max="12" value="1" required /> .
  <input class="input-line" type="number" name="datum_leto" min="2023" max="2100" value="2025" required />
  <br />

  <label>Visina:</label>
  <input class="input-line" type="number" name="visina" step="0.01" value="100.00" required /> cm
  <br />

  <label>Wifi čas:</label>
  <input class="input-line" type="number" name="wifi_cas" min="0" value="30" required /> s
  <br />

  <label>Obvestilo napetost:</label>
  <input class="input-line" type="number" name="obvestilo_napetost" step="0.01" value="11.00" required /> V
  <br />

  <label>Obvestilo krmilo:</label>
  <input class="input-line" type="number" name="obvestilo_krmilo" min="0" max="100" value="20" required /> %
  <br />

  <label>Obvestilo številka:</label>
  <input type="tel" name="obvestilo_stevilka" value="+38631280019" pattern="^\+?\d{7,15}$" title="Vnesite veljavno telefonsko številko" required />
  <br />

  <div class="btn-group">
    <button type="submit">Potrdi</button>
    <button type="button" onclick="window.history.back();">Nazaj</button>
  </div>
</form>

<!-- Nastavitve krmilnice -->
<form action="/" method="GET" novalidate>
  <div style="margin-bottom: 10px; font-size: 0.9em;">15.38 7.1.2025</div>
  <h3>Krmilnica</h3>
  <div style="margin-bottom: 10px;">Casovnika on</div>

  <label>Ura 1:</label>
  <input class="input-line" type="number" name="ura1_h" min="0" max="23" value="15" required /> h :
  <input class="input-line" type="number" name="ura1_min" min="0" max="59" value="40" required /> min
  <br />

  <label>Ura 2:</label>
  <input class="input-line" type="number" name="ura2_h" min="0" max="23" value="16" required /> h :
  <input class="input-line" type="number" name="ura2_min" min="0" max="59" value="50" required /> min
  <input type="checkbox" id="casovnik_2" name="casovnik_2" checked />
  <label for="casovnik_2" style="display: inline; font-weight: normal; cursor: pointer;">casovnik 2</label>
  <br />

  <label>Čas delovanja:</label>
  <input class="input-line" type="number" name="cas_delovanja" min="0" value="20" required /> s
  <br />

  <label>Hitrost motorja:</label>
  <input class="input-line" type="number" name="hitrost_motorja" min="0" max="100" value="100" required /> %
  <br />

  <label>Dnevi v tednu:</label>
  <div class="days">
    <label><input type="checkbox" name="dni[]" value="PON" checked /> PON</label>
    <label><input type="checkbox" name="dni[]" value="TOR" checked /> TOR</label>
    <label><input type="checkbox" name="dni[]" value="SRE" checked /> SRE</label>
    <label><input type="checkbox" name="dni[]" value="CET" checked /> ČET</label>
    <label><input type="checkbox" name="dni[]" value="PET" checked /> PET</label>
    <label><input type="checkbox" name="dni[]" value="SOB" checked /> SOB</label>
    <label><input type="checkbox" name="dni[]" value="NED" checked /> NED</label>
  </div>

  <div class="btn-group">
    <button type="submit">Potrdi</button>
    <button type="button">Stanje</button>
    <button type="button">Test</button>
    <button type="button">GSM</button>
    <button type="button">Nastavitve</button>
  </div>
</form>

</body>
</html>
