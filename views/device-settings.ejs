<!DOCTYPE html>
<html lang="sl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nastavitve Naprave in Krmilnica</title>
  <style>
    body {
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      margin: 20px 12px;
      background-color: #f9f9f9;
      color: #222;
    }
    h3 {
      margin-bottom: 15px;
      font-weight: 700;
      border-bottom: 2px solid #007bff;
      padding-bottom: 6px;
      color: #007bff;
    }
    label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
    }
    .input-inline {
      display: inline-block;
      margin-right: 12px;
      vertical-align: middle;
    }
    input[type="number"],
    input[type="tel"] {
      width: 70px;
      padding: 6px 10px;
      font-size: 1em;
      border-radius: 5px;
      border: 1px solid #ccc;
      box-sizing: border-box;
      vertical-align: middle;
      color: #333;
      background-color: #fff;
      transition: border-color 0.3s ease;
    }
    input[type="number"]:focus,
    input[type="tel"]:focus {
      border-color: #007bff;
      outline: none;
      background-color: #e9f2ff;
    }
    input[type="checkbox"] {
      transform: scale(1.3);
      margin-right: 8px;
      vertical-align: middle;
      cursor: pointer;
    }
    .days {
      margin-left: 5px;
      margin-top: 8px;
      margin-bottom: 15px;
    }
    .days label {
      font-weight: normal;
      display: block;
      margin-bottom: 4px;
      cursor: pointer;
    }
    button {
      background-color: #007bff;
      border: none;
      color: white;
      padding: 10px 18px;
      margin-top: 15px;
      margin-right: 12px;
      font-size: 1em;
      border-radius: 25px;
      cursor: pointer;
      box-shadow: 0 4px 6px rgba(0,123,255,0.3);
      user-select: none;
      transition: background-color 0.3s ease;
    }
    button:hover {
      background-color: #0056b3;
      box-shadow: 0 5px 12px rgba(0,86,179,0.5);
    }
    button:active {
      background-color: #003d7a;
    }
    form {
      background-color: #fff;
      padding: 16px 24px 28px 24px;
      border-radius: 12px;
      box-shadow: 0 6px 15px rgba(0,0,0,0.07);
      max-width: 480px;
      margin-bottom: 40px;
      box-sizing: border-box;
    }
    .small-note {
      color: #555;
      font-size: 0.9em;
      margin-bottom: 10px;
    }
  </style>
</head>
<body>

  <!-- Stran: Nastavitve naprave -->
  <form action="/submit-settings" method="POST" novalidate>
    <h3>Nastavitve</h3>

    <label>Ura:</label>
    <span class="input-inline"><input type="number" name="ura_h" min="0" max="23" value="15" required /> h</span>
    <span class="input-inline"><input type="number" name="ura_min" min="0" max="59" value="38" required /> min</span>

    <label>Datum:</label>
    <span class="input-inline"><input type="number" name="datum_dan" min="1" max="31" value="7" required /></span> .
    <span class="input-inline"><input type="number" name="datum_mesec" min="1" max="12" value="1" required /></span> .
    <span class="input-inline"><input type="number" name="datum_leto" min="2023" max="2100" value="2025" required /></span>

    <label>Višina:</label>
    <input type="number" name="visina" step="0.01" value="100.00" required /> cm

    <label>Wifi čas:</label>
    <input type="number" name="wifi_cas" min="0" value="30" required /> s

    <label>Obvestilo napetost:</label>
    <input type="number" name="obvestilo_napetost" step="0.01" value="11.00" required /> V

    <label>Obvestilo krmilo:</label>
    <input type="number" name="obvestilo_krmilo" min="0" max="100" value="20" required /> %

    <label>Obvestilo številka:</label>
    <input type="tel" name="obvestilo_stevilka" value="+38631280019" pattern="^\+?\d{7,15}$" title="Vnesite veljavno telefonsko številko" required />

    <button type="submit">Potrdi</button>
    <button type="button" onclick="window.history.back();">Nazaj</button>
  </form>

  <!-- Stran: Nastavitve krmilnice -->
  <form action="/submit-timer" method="POST" novalidate>
    <h3>Krmilnica</h3>
    <div class="small-note">Časovnika on</div>

    <label>Ura 1:</label>
    <span class="input-inline"><input type="number" name="ura1_h" min="0" max="23" value="15" required /> h</span>
    <span class="input-inline"><input type="number" name="ura1_min" min="0" max="59" value="40" required /> min</span>

    <label>Ura 2:</label>
    <span class="input-inline"><input type="number" name="ura2_h" min="0" max="23" value="16" required /> h</span>
    <span class="input-inline"><input type="number" name="ura2_min" min="0" max="59" value="50" required /> min</span>
    <span>
      <input type="checkbox" name="casovnik_2" id="casovnik_2" checked />
      <label for="casovnik_2" style="display: inline; font-weight: 600; margin-left: 4px; cursor: pointer;">časovnik 2</label>
    </span>

    <label>Čas delovanja:</label>
    <input type="number" name="cas_delovanja" min="0" value="20" required /> s

    <label>Hitrost motorja:</label>
    <input type="number" name="hitrost_motorja" min="0" max="100" value="100" required /> %

    <label>Dnevi v tednu:</label>
    <div class="days">
      <label><input type="checkbox" name="dni[]" value="PON" checked /> PON</label>
      <label><input type="checkbox" name="dni[]" value="TOR" checked /> TOR</label>
      <label><input type="checkbox" name="dni[]" value="SRE" checked /> SRE</label>
      <label><input type="checkbox" name="dni[]" value="CET" checked /> ČET</label>
      <label><input type="checkbox" name="dni[]" value="PET" checked /> PET</label>
      <label><input type="checkbox" name="dni[]" value="SOB" checked /> SOB</label>
      <label><input type="checkbox" name="dni[]" value="NED" checked /> NED</label>
    </div>

    <button type="submit">Potrdi</button>
  </form>

</body>
</html>
