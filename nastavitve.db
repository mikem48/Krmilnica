CREATE TABLE device_settings (
  id INT AUTO_INCREMENT PRIMARY KEY,

  device_id VARCHAR(20) NOT NULL,
  UNIQUE KEY(device_id),

  ura_h TINYINT UNSIGNED NOT NULL,
  ura_min TINYINT UNSIGNED NOT NULL,
  datum_dan TINYINT UNSIGNED NOT NULL,
  datum_mesec TINYINT UNSIGNED NOT NULL,
  datum_leto SMALLINT UNSIGNED NOT NULL,

  visina DECIMAL(6,2) NOT NULL,
  wifi_cas INT UNSIGNED NOT NULL,
  obvestilo_napetost DECIMAL(5,2) NOT NULL,
  obvestilo_krmilo TINYINT UNSIGNED NOT NULL,
  obvestilo_stevilka VARCHAR(20) NOT NULL,

  casovnika_on BOOLEAN NOT NULL DEFAULT TRUE,
  ura1_h TINYINT UNSIGNED NOT NULL,
  ura1_min TINYINT UNSIGNED NOT NULL,
  ura2_h TINYINT UNSIGNED DEFAULT NULL,
  ura2_min TINYINT UNSIGNED DEFAULT NULL,
  casovnik2 BOOLEAN NOT NULL DEFAULT FALSE,
  cas_delovanja INT UNSIGNED NOT NULL,
  hitrost_motorja TINYINT UNSIGNED NOT NULL,

  pon BOOLEAN NOT NULL DEFAULT TRUE,
  tor BOOLEAN NOT NULL DEFAULT TRUE,
  sre BOOLEAN NOT NULL DEFAULT TRUE,
  cet BOOLEAN NOT NULL DEFAULT TRUE,
  pet BOOLEAN NOT NULL DEFAULT TRUE,
  sob BOOLEAN NOT NULL DEFAULT TRUE,
  ned BOOLEAN NOT NULL DEFAULT TRUE,

  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);
