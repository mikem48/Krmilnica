<!DOCTYPE html>
<html lang="sl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Nastavitve naprave</title>
<style>
  body {
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    margin: 0;
    background: linear-gradient(135deg, #6371c7 0%, #8059c7 100%);
    color: #222;
    min-height: 100vh;
    padding: 30px;
    box-sizing: border-box;
  }
  header {
    color: white;
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 28px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  header .icon-device {
    font-size: 1.8rem;
    user-select: none;
  }
  .settings-card {
    background: white;
    border-radius: 16px;
    padding: 24px 28px 32px;
    width: 340px;
    box-shadow: 0 8px 25px rgb(0 0 0 / 0.15);
    margin-bottom: 40px;
  }
  .settings-header {
    background-color: #3671f3;
    border-radius: 12px 12px 0 0;
    font-weight: 600;
    color: white;
    font-size: 1.1rem;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .device-status {
    margin-left: auto;
    font-weight: 600;
    color: #f44336;
    display: flex;
    align-items: center;
    gap: 6px;
    user-select: none;
  }
  .status-dot {
    width: 14px;
    height: 14px;
    background-color: #f44336;
    border-radius: 50%;
  }
  .settings-content {
    padding: 24px 16px 0 16px;
    font-size: 0.93rem;
  }
  .settings-content b {
    font-weight: 700;
  }
  .settings-content em {
    font-style: italic;
    color: #666;
    display: block;
    margin: 14px 0 0;
    font-size: 0.85rem;
  }
  .btn-settings {
    margin-top: 24px;
    padding: 11px 24px;
    border-radius: 30px;
    background-color: #007aff;
    border: none;
    color: white;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 5px 12px rgba(0,122,255,0.5);
    user-select: none;
    text-decoration: none;
  }
  .btn-settings:hover {
    background-color: #005bb5;
  }
  .icon-gear {
    font-size: 1.25rem;
    user-select: none;
  }
  form.settings-form {
    width: 340px;
    background: white;
    border-radius: 16px;
    padding: 28px 32px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    font-size: 0.92rem;
  }
  form label {
    display: block;
    font-weight: 600;
    margin-bottom: 6px;
  }
  form input[type=number],
  form input[type=tel] {
    width: 100%;
    padding: 10px 14px;
    border-radius: 8px;
    border: 1.8px solid #ddd;
    margin-bottom: 18px;
    font-size: 1rem;
    color: #333;
    box-sizing: border-box;
  }
  form input[type=number]:focus,
  form input[type=tel]:focus {
    outline: none;
    border-color: #3671f3;
    background-color: #e9f2ff;
  }
  /* Inline skupine za manjše število inputov na isti vrstici */
  .inline-inputs {
    display: flex;
    gap: 12px;
  }
  .inline-inputs > input {
    flex: 1 1 0;
    margin-bottom: 18px;
  }
  .btn-group {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 10px;
  }
  form button {
    flex: 1;
    padding: 14px 0;
    font-weight: 700;
    border-radius: 28px;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    user-select: none;
  }
  button.submit-btn {
    background-color: #007aff;
    color: white;
    box-shadow: 0 5px 15px rgba(0,122,255,0.5);
    transition: background-color 0.3s ease;
  }
  button.submit-btn:hover {
    background-color: #005bb5;
  }
  button.cancel-btn {
    background-color: #ddd;
    color: #444;
  }
  button.cancel-btn:hover {
    background-color: #bbb;
  }
  
  /* Sekcija za Nastavitve krmilnice */
  .controller-section {
    width: 340px;
    background: white;
    border-radius: 16px;
    padding: 28px 32px;
    margin-top: 36px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    font-size: 0.92rem;
  }
  .controller-section h3 {
    font-weight: 600;
    color: #222;
    margin-bottom: 24px;
    font-size: 1.15rem;
  }
  .controller-section label {
    font-weight: 600;
    margin-bottom: 6px;
    display: block;
  }
  .controller-section .inline-inputs {
    display: flex;
    gap: 12px;
    margin-bottom: 18px;
  }
  .controller-section .inline-inputs > input {
    flex: 1 1 0;
  }
  .controller-section input[type=number] {
    padding: 10px 14px;
    border-radius: 8px;
    border: 1.8px solid #ddd;
    width: 100%;
    font-size: 1rem;
    color: #333;
  }
  .controller-section input[type=number]:focus {
    outline: none;
    border-color: #3671f3;
    background-color: #e9f2ff;
  }
  .controller-section input[type=checkbox] {
    margin-right: 7px;
    transform: scale(1.1);
    vertical-align: middle;
  }
  .controller-section .days {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-bottom: 24px;
  }
  .controller-section .days label {
    font-weight: normal;
    cursor: pointer;
    user-select: none;
  }
  
</style>
</head>
<body>

<header>
  <span class="icon-device">🛠️</span>
  <span>ESP32 Nastavitve naprave</span>
</header>

<!-- Obstoječa kartica naprave -->
<section class="settings-card">
  <div class="settings-header">
    <span>krmilnica1</span>
    <span class="device-status"><span class="status-dot"></span>Offline</span>
  </div>
  <div class="settings-content">
    ID: ABCDEFGH<br>
    <b>Vrednost 1:</b> 25.30<br>
    <b>Vrednost 2:</b> 62.50<br>
    <em>Zadnja posodobitev: 16. 1. 2026, 22:34:02</em>
    <a href="#" class="btn-settings"><span class="icon-gear">⚙️</span> Nastavitve</a>
  </div>
</section>

<!-- Forma za osnovne nastavitve naprave -->
<form class="settings-form" action="/submit-settings" method="GET" novalidate>
  <label>Ura</label>
  <div class="inline-inputs">
    <input type="number" name="ura_h" min="0" max="23" value="15" required placeholder="hh" />
    <input type="number" name="ura_min" min="0" max="59" value="38" required placeholder="mm" />
  </div>

  <label>Datum</label>
  <div class="inline-inputs">
    <input type="number" name="datum_dan" min="1" max="31" value="7" required placeholder="dd" />
    <input type="number" name="datum_mesec" min="1" max="12" value="1" required placeholder="mm" />
    <input type="number" name="datum_leto" min="2023" max="2100" value="2025" required placeholder="yyyy" />
  </div>

  <label>Višina (cm)</label>
  <input type="number" step="0.01" name="visina" value="100.00" required />

  <label>Wifi čas (s)</label>
  <input type="number" name="wifi_cas" min="0" value="30" required />

  <label>Obvestilo napetost (V)</label>
  <input type="number" step="0.01" name="obvestilo_napetost" value="11.00" required />

  <label>Obvestilo krmilo (%)</label>
  <input type="number" name="obvestilo_krmilo" min="0" max="100" value="20" required />

  <label>Obvestilo številka</label>
  <input type="tel" name="obvestilo_stevilka" value="+38631280019" pattern="^\+?\d{7,15}$" title="Vnesite veljavno telefonsko številko" required />

  <div class="btn-group">
    <button type="submit" class="submit-btn">Potrdi</button>
    <button type="button" class="cancel-btn" onclick="window.history.back();">Nazaj</button>
  </div>
</form>

<!-- Forma za nastavitve krmilnice -->
<section class="controller-section">
  <h3>Nastavitve krmilnice</h3>
  
  <form action="/submit-timer" method="GET" novalidate>
    <label>Ura 1</label>
    <div class="inline-inputs">
      <input type="number" name="ura1_h" min="0" max="23" value="15" required placeholder="hh" />
      <input type="number" name="ura1_min" min="0" max="59" value="40" required placeholder="mm" />
    </div>

    <label>Ura 2</label>
    <div class="inline-inputs" style="align-items:center;">
      <input type="number" name="ura2_h" min="0" max="23" value="16" required placeholder="hh" />
      <input type="number" name="ura2_min" min="0" max="59" value="50" required placeholder="mm" />
      <input type="checkbox" name="casovnik_2" id="casovnik_2" checked />
      <label for="casovnik_2" style="margin:0; cursor:pointer; font-weight:600;">časovnik 2</label>
    </div>

    <label>Čas delovanja (s)</label>
    <input type="number" name="cas_delovanja" min="0" value="20" required />

    <label>Hitrost motorja (%)</label>
    <input type="number" name="hitrost_motorja" min="0" max="100" value="100" required />

    <label>Dnevi v tednu</label>
    <div class="days">
      <label><input type="checkbox" name="dni[]" value="PON" checked /> PON</label>
      <label><input type="checkbox" name="dni[]" value="TOR" checked /> TOR</label>
      <label><input type="checkbox" name="dni[]" value="SRE" checked /> SRE</label>
      <label><input type="checkbox" name="dni[]" value="CET" checked /> ČET</label>
      <label><input type="checkbox" name="dni[]" value="PET" checked /> PET</label>
      <label><input type="checkbox" name="dni[]" value="SOB" checked /> SOB</label>
      <label><input type="checkbox" name="dni[]" value="NED" checked /> NED</label>
    </div>

    <div class="btn-group">
      <button type="submit" class="submit-btn">Potrdi</button>
    </div>
  </form>
</section>

</body>
</html>
