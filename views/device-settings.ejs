<!DOCTYPE html>
<html lang="sl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nastavitve naprave in krmilnice</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>

<div class="container main-content">
  <h2>Nastavitve naprave in krmilnice</h2>

  <form action="/settings" method="POST" class="settings-form">
    <input type="hidden" name="device_id" value="<%= settings.device_id %>">
    <fieldset>
      <legend><strong>Nastavitve naprave</strong></legend>

      <label>Ura:
        <input class="small-input" type="number" name="ura_h" min="0" max="23" value="<%= settings.ura_h || '' %>" required> h :
        <input class="small-input" type="number" name="ura_min" min="0" max="59" value="<%= settings.ura_min || '' %>" required> min
      </label>

      <label>Datum:
        <input class="small-input" type="number" name="datum_dan" min="1" max="31" value="<%= settings.datum_dan || '' %>" required> .
        <input class="small-input" type="number" name="datum_mesec" min="1" max="12" value="<%= settings.datum_mesec || '' %>" required> .
        <input class="small-input" type="number" name="datum_leto" min="2020" max="2100" value="<%= settings.datum_leto || '' %>" required>
      </label>

      <label>Visina:
        <input type="number" step="0.01" name="visina" value="<%= settings.visina || '' %>" required> cm
      </label>

      <label>Wifi čas:
        <input type="number" name="wifi_cas" value="<%= settings.wifi_cas || '' %>" required> s
      </label>

      <label>Obvestilo napetost:
        <input type="number" step="0.01" name="obvestilo_napetost" value="<%= settings.obvestilo_napetost || '' %>" required> V
      </label>

      <label>Obvestilo krmilo:
        <input type="number" name="obvestilo_krmilo" value="<%= settings.obvestilo_krmilo || '' %>" required> %
      </label>

      <label>Obvestilo številka:
        <input type="text" name="obvestilo_stevilka" value="<%= settings.obvestilo_stevilka || '' %>" required>
      </label>
    </fieldset>

    <hr>

    <fieldset>
      <legend><strong>Krmilnica</strong></legend>

      <p>Časovnika: <%= settings.casovnika_on ? 'on' : 'off' %></p>

      <label>Ura 1:
        <input class="small-input" type="number" name="ura1_h" min="0" max="23" value="<%= settings.ura1_h || '' %>" required> h :
        <input class="small-input" type="number" name="ura1_min" min="0" max="59" value="<%= settings.ura1_min || '' %>" required> min
      </label>

      <label>
        Ura 2:
        <input class="small-input" type="number" name="ura2_h" min="0" max="23" value="<%= settings.ura2_h || '' %>" > h :
        <input class="small-input" type="number" name="ura2_min" min="0" max="59" value="<%= settings.ura2_min || '' %>" > min
        <input type="checkbox" name="casovnik2" <%= settings.casovnik2 ? 'checked' : '' %> > časovnik 2
      </label>

      <label>Čas delovanja:
        <input type="number" name="cas_delovanja" value="<%= settings.cas_delovanja || '' %>" required> s
      </label>

      <label>Hitrost motorja:
        <input type="number" name="hitrost_motorja" value="<%= settings.hitrost_motorja || '' %>" required> %
      </label>

      <div>
        <label><input type="checkbox" name="pon" <%= settings.pon ? 'checked' : '' %> > PON</label><br>
        <label><input type="checkbox" name="tor" <%= settings.tor ? 'checked' : '' %> > TOR</label><br>
        <label><input type="checkbox" name="sre" <%= settings.sre ? 'checked' : '' %> > SRE</label><br>
        <label><input type="checkbox" name="cet" <%= settings.cet ? 'checked' : '' %> > CET</label><br>
        <label><input type="checkbox" name="pet" <%= settings.pet ? 'checked' : '' %> > PET</label><br>
        <label><input type="checkbox" name="sob" <%= settings.sob ? 'checked' : '' %> > SOB</label><br>
        <label><input type="checkbox" name="ned" <%= settings.ned ? 'checked' : '' %> > NED</label>
      </div>
    </fieldset>

    <button class="btn btn-primary" type="submit">Potrdi</button>
    <a href="/" class="btn btn-secondary">Nazaj</a>

  </form>

  <div class="menu-buttons" style="margin-top: 20px;">
    <a href="/stanje" class="btn btn-info">Stanje</a>
    <a href="/test" class="btn btn-info">Test</a>
    <a href="/gsm" class="btn btn-info">GSM</a>
    <a href="/settings" class="btn btn-info">Nastavitve</a>
  </div>
</div>
</body>
</html>
